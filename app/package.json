{
  "name": "striation-app",
  "private": true,
  "type": "module",
  "description": "Striation: the live site and Netlify Functions that run the striae library on pump.fun creates",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs --port 8888",
    "watch": "node scripts/dev.mjs --port 8888 --watch",
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node test/smoke.mjs http://localhost:8888",
    "record": "node test/record.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "three": "0.186.1"
  }
}
