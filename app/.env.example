# Copy to app/.env for `npm run dev` (never commit .env). On Netlify, set these under Site configuration → Environment variables.

# Required. Helius mainnet RPC key: /api/match (getTransactionsForAddress, getTransaction) and the feed refresh (getSignaturesForAddress + getTransaction).
HELIUS_API_KEY=

# Optional. Not used for data; /api/health only reports whether it is set (true/false, never the value).
BIRDEYE_API_KEY=

# Local only, set by scripts/dev.mjs to app/.data: a folder of JSON files used instead of Netlify Blobs. Leave unset on Netlify.
STRIATION_STORE_DIR=
