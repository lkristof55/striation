{
  "name": "striae",
  "version": "0.1.0",
  "description": "Ballistics for Solana launches: fingerprint a pump.fun create transaction and name the tool that fired it.",
  "type": "module",
  "license": "MIT",
  "author": "Striation contributors",
  "repository": { "type": "git", "url": "https://github.com/lkristof55/striation" },
  "keywords": ["solana", "pump.fun", "transaction", "fingerprint", "forensics", "jaccard", "knn"],
  "engines": { "node": ">=20.10" },
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./src/index.js" },
    "./reference.json": "./data/reference.json",
    "./package.json": "./package.json"
  },
  "bin": { "striae": "./bin/striae.js" },
  "files": ["src", "bin", "data/reference.json", "index.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/",
    "bench": "node bench/bench.js",
    "build:ref": "node scripts/build-reference.js",
    "record": "node scripts/record.js",
    "scrub": "node scripts/scrub.js"
  },
  "dependencies": {}
}
